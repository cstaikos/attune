{
  "name": "attune-staging",
  "compatibility_date": "2026-09-13",
  "assets": {
    "directory": "./dist/resonance/browser",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "staging": {
      "name": "attune-staging",
      "assets": {
        "directory": "./dist/staging/browser",
        "not_found_handling": "single-page-application"
      }
    },
    "production": {
      "name": "attune-production",
      "assets": {
        "directory": "./dist/production/browser",
        "not_found_handling": "single-page-application"
      }
    }
  }
}
