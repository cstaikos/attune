# Copy to .env.staging or .env.production. Both are ignored by Git.
# Optional for interactive deployments after `pnpm dlx wrangler@4 login`.
# For CI, inject these through the CI secret store instead.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Database migration credentials only; never compiled into the frontend.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
# Sentry source-map upload only; never included in browser configuration.
SENTRY_AUTH_TOKEN=
